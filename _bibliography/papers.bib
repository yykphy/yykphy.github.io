  annotation = {这篇工作在AMO领域发展了围道变形法（CDM），通过在非厄米复动量空间中求解Schr\"odinger方程，可直接揭示束缚态、连续态和共振态。这项研究为探索复杂分子系统中的共振提供了一种高效且稳定的工具。}
}

@article{yang2020njp,
  title = {Particle scattering and resonances involving avoided crossing},
  author = {Yang, Yu Kun and Cheng, Yongjun and Wu, Yong and Qu, Yi Zhi and Wang, Jian Guo and Zhang, Song Bin},
