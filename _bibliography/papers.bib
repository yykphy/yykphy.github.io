  journal = {New Journal of Physics},
  volume = {22},
  number = {12},
  pages = {123022},
  doi = {10.1088/1367-2630/abcfed},
  sortkey = {01-2020njp},
  annotation = {这篇工作探讨了重离子散射中涉及非绝热电子耦合的避免交叉区的共振现象，并提出利用Zhu-Nakamura参数$a^2$可以定量评估共振态对散射截面的影响。相关理论为候选分子在避免交叉区 Feshbach 共振研究提供了一种简单途径。}
}


@article{yang2020jqsrt,
